{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_MAPBOX_TOKEN": "@vite_mapbox_token",
    "VITE_MAPBOX_PUBLIC_TOKEN": "@vite_mapbox_token"
  },
  "build": {
    "env": {
      "VITE_MAPBOX_TOKEN": "@vite_mapbox_token",
      "VITE_MAPBOX_PUBLIC_TOKEN": "@vite_mapbox_token"
    }
  }
}
